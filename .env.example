# Copy this file to .env and fill in the values you need.
# The .env file is git-ignored — never commit it.

# Materials Project API key. Only required for reference resolution OUTSIDE
# the 9 curated end-members in Data/reference_systems.json (UN, UC, CeO2,
# UO2, PuO2, ThO2, ZrO2, Nd2O3, NdO2), and for `cli.py build --force`
# (a full re-query of Materials Project). A normal build/train/predict cycle
# using the committed seed dataset needs NO key at all.
# Get one at https://materialsproject.org/api
MP_API_KEY=

# HuggingFace access token. Only required to run scripts/fetch_models.py
# against the private model repo. Get one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional override for where the large regenerable artifacts (Dataset/,
# Models/binaries/) live on disk. Defaults to this repository's own root if
# unset — most users should leave this blank. Only set this if you are
# running this engine from a second checkout (e.g. a git submodule) and want
# it to reuse a primary checkout's artifacts instead of fetching its own copy.
LATTICE_DATA_ROOT=
